rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{productId} {
      allow read, write: if true;
    }

    match /categories/{categoryId} {
      allow read, write: if true;
    }

    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Dedicated UPI QR code document (public get for checkout QR display, size-validated write)
    match /settings/upi_qr {
      allow get: if true;
      allow list: if false;
      allow write: if request.resource.data.imageBase64 is string
                   && request.resource.data.imageBase64.size() < 950000;
    }

    // General store settings
    match /settings/{docId} {
      allow read, write: if true;
    }

    // Dedicated Payment Screenshots collection (Firestore-only Base64 storage)
    // Individual get allowed (customer viewing order proof, admin verification)
    // Public listing/scraping disallowed to protect customer payment privacy
    // Create allowed only with string payload within safe document size limit (< 950KB)
    match /payment_screenshots/{screenshotId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.resource.data.imageBase64 is string
                    && request.resource.data.imageBase64.size() < 950000;
      allow update, delete: if false;
    }

    match /adminUsers/{uid} {
      allow read, write: if true;
    }

    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    match /orders/{orderId}/sellerMessages/{messageId} {
      allow read, write: if true;
    }

    // Secure Customer Vault & Registry (Zero-Knowledge Cryptographic Access)
    // Disallow public listing or collection querying to protect customer privacy and prevent database scraping.
    // Access is granted only by exact cryptographically derived keys.
    match /customer_vault/{vaultKey} {
      allow list: if false;
      allow get, create, update: if true;
      allow delete: if false;
    }

    match /customer_registry/{regKey} {
      allow list: if false;
      allow get, create, update: if true;
      allow delete: if false;
    }

    // Legacy Customer Profiles (protected from collection listing)
    match /customer_profiles/{mobile} {
      allow list: if false;
      allow get, write: if true;
    }
  }
}
